<Window x:Class="JingjingReader.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 鲸鲸阅读器"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="鲸鲸阅读器" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Windows 上的 Markdown 阅读器"
                       Margin="0,4,0,0"
                       Foreground="#666666" />
        </StackPanel>

        <!-- 诊断信息：只读、可选中复制；内容由 AboutInfo.BuildText 生成（版本/环境/数据目录/关联状态）。 -->
        <TextBox x:Name="InfoText"
                 Grid.Row="1"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 FontSize="13" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="打开默认应用设置" Padding="12,4" Margin="0,0,8,0" Click="OnOpenDefaultApps" />
            <Button Content="打开数据目录" Padding="12,4" Margin="0,0,8,0" Click="OnOpenDataDir" />
            <Button Content="复制诊断信息" Padding="12,4" Margin="0,0,8,0" Click="OnCopyDiagnostics" />
            <Button Content="关闭" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
