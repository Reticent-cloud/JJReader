<?xml version="1.0" encoding="utf-8"?>
<!--
  鲸鲸阅读器应用清单（Task 17）。
  - DPI：PerMonitorV2（WPF 在 .NET 10 下的推荐值），旧系统回退 true/pm；
  - 长路径：longPathAware=true，配合宿主 FileHost 的 \\?\ 前缀支持 >255 字符路径；
  - 兼容性：声明 Windows 10/11（同一 supportedOS GUID），让版本 API 返回真实版本而不是兼容性视图版本；
  - 执行级别 asInvoker：.md 关联只写 HKCU，不需要管理员权限。
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="JingjingReader.app" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*" />
    </dependentAssembly>
  </dependency>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- 旧版 Windows（Win8.1 及以前）读取的 DPI 感知声明：PerMonitor 的兼容写法。 -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <!-- Windows 10 1703+：PerMonitorV2（多显示器不同缩放时亚像素级正确）。 -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
